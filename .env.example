# ---- Required ----
# MySQL 8 / MariaDB. Add ?ssl=true for managed databases (Aiven, etc.) and set DATABASE_CA_CERT.
DATABASE_URL="mysql://greenfactory:greenfactory@127.0.0.1:3306/greenfactory"
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n..."
# Long random string (≥ 32 chars): openssl rand -base64 48
SESSION_SECRET=""
# Public base URL — used in QR codes and password-reset links.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Organization code that platform administrators type on the login page.
PLATFORM_ACCESS_CODE=""

# ---- Optional ----
# Password-reset email via Resend (without it, dev prints the link to the server log).
RESEND_API_KEY=""
EMAIL_FROM="GreenFactory Insight <no-reply@example.com>"
# G-FAY assistant (Claude API). Without a key the assistant answers from built-in summaries.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL=""
# Uploaded files (evidence, avatars, logos). Use object storage on serverless hosts.
STORAGE_DIR="./storage"
# Backups (platform admin). Needs mysqldump/mysql binaries on the server.
MYSQLDUMP_PATH="mysqldump"
MYSQL_PATH="mysql"
BACKUP_DIR="./storage/backups"
# Seed: password for all demo users, or SEED_DEMO=false to skip demo data.
SEED_DEMO_PASSWORD=""
SEED_DEMO="true"
